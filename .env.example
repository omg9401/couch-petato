# ── Couch Petato — Environment Variables Template ──
# Copy this to .env and fill in your values.

# Shopify (set when ready to push products)
SHOPIFY_SHOP_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxx

# Warwick Fabrics credentials (for stock scraping)
WARWICK_EMAIL=your@email.com
WARWICK_PASSWORD=yourpassword
